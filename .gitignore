# Entornos (uv los reconstruye desde uv.lock; nunca se versionan)
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ruff_cache/
.env

# Datos crudos del TFM: privados y grandes (115 MB). Se referencian por
# TALLER_DATA_ROOT o se copian aquí localmente, pero no entran en el repo.
data/raw/*
!data/raw/.gitkeep

# Parquet grandes por defecto; el meta de ventanas (244 KB) sí se versiona
# porque los notebooks 02-04 lo necesitan.
*.parquet
!data/processed/windows_meta.parquet

# Logs de ejecución por lotes
notebooks/run_nb*.log

# Intermedios de LaTeX. La compilación de los diagramas de arquitectura ocurre
# en un temporal, pero un pdflatex lanzado a mano sí los dejaría aquí.
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
reports/figures/tex/*.log

# Artefactos pesados y reproducibles del piloto Diffusion-TS. Las métricas y
# el informe sí se versionan; checkpoints y matrices sintéticas, no.
reports/diffusion_ts_experiment/**/checkpoints/
reports/diffusion_ts_experiment/**/synthetic/
reports/diffusion_ts_experiment/smoke/
