# Entornos (uv los reconstruye desde uv.lock; nunca se versionan)
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ruff_cache/
.env

# Datos crudos del TFM: privados y grandes (115 MB). Se referencian por
# TALLER_DATA_ROOT o se copian aquí localmente, pero no entran en el repo.
data/raw/*
!data/raw/.gitkeep

# Parquet grandes por defecto; el meta de ventanas (244 KB) sí se versiona
# porque los notebooks 02-04 lo necesitan.
*.parquet
!data/processed/windows_meta.parquet

# Logs de ejecución por lotes
notebooks/run_nb*.log

# Intermedios de LaTeX. La compilación de los diagramas de arquitectura ocurre
# en un temporal, pero un pdflatex lanzado a mano sí los dejaría aquí.
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
reports/figures/tex/*.log

# El experimento exploratorio R81 no se versiona. La regla cubre la carpeta
# entera, no solo checkpoints/synthetic: sus .pt y .npy llegaron a estar
# trackeados (87 MB) porque .gitignore no destrackea lo ya anadido, y un
# `git add -A` volvia a incorporarlos. Recuperable desde el historial.
reports/diffusion_ts_experiment/

# Artefactos pesados y reproducibles del experimento Diffusion-TS R61. Las
# métricas y el informe sí se versionan; checkpoints y matrices sintéticas, no.
reports/diffusion_ts_r61/**/checkpoints/
reports/diffusion_ts_r61/**/synthetic/

# Site de apuntes NB03: artefacto local/publicado en Sites, no se versiona ni se sube a GitHub.
reports/nb03-modelos-generativos/
reports/apuntes_metricas_notebooks_01_04.html
